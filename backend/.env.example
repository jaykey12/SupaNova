APP_NAME=Kutane AI API
APP_ENV=development
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-your-api-key

# Phase 2 persistence
USE_DATABASE=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kutane
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Slack integration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/slack/oauth/callback
SLACK_SUPPORT_CHANNEL=#support
DASHBOARD_BASE_URL=http://localhost:5173

# SendGrid integration
SENDGRID_VERIFICATION_KEY=your-verification-key
SENDGRID_FROM_EMAIL=support@kutane.ai

